{
  "name": "chatjevpt",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env dev.mjs",
    "dev:mock": "JEV_MOCK=1 node dev.mjs",
    "dev:accounts": "STORE=memory DEV_LOGIN_EMAIL=dev@example.com SESSION_SECRET=local-dev-only JEV_MOCK=1 node dev.mjs",
    "test": "node --test test/*.test.js",
    "test:ui": "node --test test-ui/*.test.mjs",
    "test:content": "node --env-file-if-exists=.env scripts/eval.mjs"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.0",
    "@typesafe-ai/sdk": "^0.6.0",
    "jose": "^6.2.12"
  },
  "devDependencies": {
    "playwright-core": "1.56.1"
  }
}
