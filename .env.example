# Copy to .env for local dev. On Vercel, set these under Project → Settings → Environment Variables.
TYPESAFE_API_KEY=

# Accounts (optional; see README → Accounts). Set all three, or none.
# GOOGLE_CLIENT_ID=1234567890-abc.apps.googleusercontent.com
# SESSION_SECRET=          # openssl rand -base64 32
# DATABASE_URL=            # Neon connection string; or STORE=memory for local dev
# ADMIN_EMAILS=you@gmail.com
# DEFAULT_BUDGET_USD=0.25   (each person's total allowance; admins have no limit)
# STORE=memory
# DEV_LOGIN_EMAIL=dev@example.com   # local dev only: "Sign in as the local dev user"
